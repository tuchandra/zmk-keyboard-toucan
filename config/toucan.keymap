#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/bt.h>

#define BASE 0
#define NAV 1
#define SYM 2
#define FUNC 3
#define NUM 4

#define KEYS_L 0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29  // left hand
#define KEYS_R 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35  // right hand
#define THUMBS 36 37 38 39 40 41

/ {
  behaviors {
    hml: home_row_mod_left {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_R THUMBS>;
      hold-trigger-on-release;
    };

    hmr: home_row_mod_right {
      compatible = "zmk,behavior-hold-tap";
      #binding-cells = <2>;
      flavor = "balanced";
      tapping-term-ms = <280>;
      quick-tap-ms = <175>;
      require-prior-idle-ms = <150>;
      bindings = <&kp>, <&kp>;
      hold-trigger-key-positions = <KEYS_L THUMBS>;
      hold-trigger-on-release;
    };
  };

  keymap {
    compatible = "zmk,keymap";

    base_layer {
      label = "BASE";
      bindings = <
        &kp LGUI &kp Q &kp W &kp F &kp P &kp G
        &kp J &kp L &kp U &kp Y &kp SEMI &lt 3 MINUS
        &kp TAB &hml LGUI A &hml LALT R &hml LCTRL S &hml LSHFT T &kp D
        &kp H &hmr RSHFT N &hmr RCTRL E &hmr RALT I &hmr RGUI O &lt 2 SQT
        &lt 3 ESC &kp Z &kp X &kp C &kp V &kp B
        &kp K &kp M &kp COMMA &kp DOT &kp FSLH &lt 4 ENTER
        &kp LSHFT &kp SPACE &kp ENTER &kp RCTRL &kp BSPC &mo 1
      >;
    };

    nav_layer {
      label = "NAV";
      bindings = <
        &trans &trans &kp PGUP &kp UP &kp PGDN &trans
        &trans &kp LS(LG(N2)) &kp LS(LG(N3)) &kp LS(LG(N4)) &trans &trans
        &trans &trans &kp LEFT &kp DOWN &kp RIGHT &trans
        &trans &trans &trans &trans &trans &trans
        &trans &kp LG(Z) &kp LG(X) &kp LG(C) &kp LG(V) &trans
        &trans &kp LC(LA(TAB)) &kp RC(RS(TAB)) &kp RC(TAB) &trans &trans
        &trans &trans &trans &trans &trans &trans
      >;
    };

    sym_layer {
      label = "SYM";
      bindings = <
        &trans &kp BSLH &kp GRAVE &kp LS(BSLH) &kp LS(SEMI) &kp EQUAL
        &trans &trans &trans &trans &trans &studio_unlock
        &trans &kp LS(COMMA) &kp LS(LBKT) &kp LBKT &kp LS(N9) &kp LS(MINUS)
        &trans &trans &trans &trans &trans &trans
        &trans &kp LS(DOT) &kp LS(RBKT) &kp RBKT &kp LS(N0) &kp LS(N3)
        &trans &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans
      >;
    };

    func_layer {
      label = "FUNC";
      bindings = <
        &trans &kp F1 &kp F2 &kp F3 &kp F4 &kp C_RW
        &kp C_VOL_UP &trans &trans &trans &trans &studio_unlock
        &trans &kp F5 &kp F6 &kp F7 &kp F8 &kp C_PP
        &kp C_VOL_DN &trans &trans &trans &trans &trans
        &trans &kp F9 &kp F10 &kp F11 &kp F12 &kp C_FF
        &kp C_MUTE &trans &trans &trans &trans &trans
        &trans &trans &trans &trans &trans &trans
      >;
    };

    num_layer {
      label = "NUM";
      bindings = <
        &trans &kp LA(F13) &kp F14 &kp F15 &bt 1 &trans
        &trans &kp N7 &kp N8 &kp N9 &trans &studio_unlock
        &trans &trans &trans &trans &trans &trans
        &kp N0 &kp N1 &kp N2 &kp N3 &trans &trans
        &trans &trans &trans &trans &trans &trans
        &trans &kp N4 &kp N5 &kp N6 &trans &trans
        &trans &trans &trans &trans &trans &trans
      >;
    };
  };
};

